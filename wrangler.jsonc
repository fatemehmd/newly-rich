{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "newly-rich-guide",
	"main": "server/worker.js",
	"compatibility_date": "2026-11-20",
	"account_id": "aa825d25189287191793644813ab47c1",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		],
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "FEEDBACK",
			"database_name": "newly-rich-feedback",
			"database_id": "ea60161f-929c-4e09-8fcd-5e976734338e"
		}
	]
}